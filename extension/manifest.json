{
  "manifest_version": 3,
  "name": "FlyPassword 自动填充",
  "short_name": "FlyPassword",
  "version": "0.2.0",
  "description": "起飞密码箱浏览器自动填充：登录凭据与 MFA 验证码一键填入。",
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlyPassword"
  }
}
